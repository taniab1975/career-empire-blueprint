  "reviewPolicy": {
    "batchSizeLimit": 10,
    "approvalScope": "Overall appearance of the complete building/asset/scene item, including its listed parts unless Tania names exceptions",
    "batchApprovalAuthorisesNextProductionStage": false,
    "ambiguousReply": "Do not infer asset approval or production authority. Resolve the named batch/assets first.",
    "revisionRule": "Track every file/version change. Return materially changed appearance to whole-item review; routine changes that preserve accepted appearance need documented technical verification, not a new wall-by-wall approval. Preserve the original decision and exact reviewed item snapshot.",
    "states": [
      "awaiting-review",
      "approved",
      "changes-requested",
      "on-hold",
      "rejected",
      "superseded",
      "included-in-item-review"
    ],
    "requiredEvidence": "Exact user instruction, date, approver, item/batch revision and reviewed assembly/component snapshot; named exceptions if any.",
    "batchUnit": "Complete review item/package, not individual component parts",
    "incompleteItemRule": "An item without its full assembly cannot receive whole-item approval. Component-specific decisions may be recorded explicitly; they do not imply item approval.",
    "exceptionRule": "Only named exceptions need component-specific follow-up. An unflagged wall, flower or other listed part does not require a separate approval.",
    "componentApprovalRequired": false,
    "itemApprovalCoversListedComponents": true
  },
